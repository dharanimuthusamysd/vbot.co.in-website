# ---- Server ----
PORT=4000

# ---- MySQL (hosted) ----
# Fill these in with your hosting provider's connection details
# (PlanetScale, Railway, RDS, DigitalOcean, Hostinger, etc. all give you these 5 values)
DB_HOST=your-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=vbot

# Some hosts (e.g. PlanetScale, many managed MySQL providers) require SSL.
# Set to "true" if your provider requires it — check their connection docs.
DB_SSL=false

# ---- Email (Gmail) ----
# Do NOT use your normal Gmail password here — Gmail blocks that.
# You must generate a 16-character "App Password" from your Google Account.
# See the README for step-by-step instructions.
GMAIL_USER=whatsappvbot@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Where booking notification emails should be sent (usually same as GMAIL_USER)
NOTIFY_EMAIL=whatsappvbot@gmail.com

# ---- CORS ----
# Your Angular app's origin(s), comma-separated. Add your production domain too.
CORS_ORIGIN=http://localhost:4200
